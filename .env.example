# Copy to .env and fill in. Every enact binary loads .env from its working
# directory at startup. All variables below except the Bedrock credentials
# have sensible defaults baked into the code, so a minimal .env only needs the
# Bedrock settings.

# --- Bedrock (required for inference + embeddings) -------------------------
AWS_REGION=eu-north-1
BEDROCK_API_KEY=replace-me
# Standard AWS SDK credential env vars are also honoured if you are not using
# a Bedrock API key:
# AWS_PROFILE=...
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...

# Embedding model used by the indexer and the inference RAG flow. Its output
# dimension MUST equal BEDROCK_EMBEDDING_DIM (used to create the k-NN index).
BEDROCK_EMBEDDING_MODEL=amazon.titan-embed-text-v2:0
BEDROCK_EMBEDDING_DIM=1024

# --- OpenSearch (metadata + vectors) ---------------------------------------
OPENSEARCH_ADDRESSES=https://localhost:9200
OPENSEARCH_USERNAME=admin
OPENSEARCH_PASSWORD="9zT!mPq4#bRk7Fx2"
OPENSEARCH_INSECURE_SKIP_VERIFY=true

# Per-platform index names. Defaults match what `make infrastructure-up`
# provisions; override these to point services at differently-named indices
# (e.g. a per-tenant or per-environment suffix). If you change them, you must
# also create the indices yourself — scripts/infrastructure.sh still creates
# the defaults.
OPENSEARCH_INDEX_KNOWLEDGE_BASES=enact-knowledge-bases
OPENSEARCH_INDEX_AGENTS=enact-agents
OPENSEARCH_INDEX_KB_DOCUMENTS=enact-kb-documents
OPENSEARCH_INDEX_AGENT_RAG_CHUNKS=enact-agent-rag-chunks
OPENSEARCH_INDEX_USERS=enact-users

# --- Redis Streams (document indexing queue) -------------------------------
REDIS_ADDR=localhost:6379


# --- Tika (document text extraction, used by the KB indexer) ---------------
TIKA_URL=http://localhost:9998
# TIKA_TIMEOUT=120s


# --- RAG tuning ------------------------------------------------------------
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=150

# --- OpenTelemetry / LGTM observability ------------------------------------
# Services export traces to Tempo, metrics to Mimir, and logs to Loki over
# OTLP/HTTP. The defaults target the local stack in
# deploy/docker-compose.lgtm.yml (bring it up with `make observability-up`),
# reachable on localhost via its published ports. Endpoints are FULL URLs
# including the signal path, per the OpenTelemetry spec.
#
# Set OTEL_SDK_DISABLED=true to turn telemetry off entirely (no exporters,
# near-zero overhead) — useful when the LGTM stack is not running.
# OTEL_SDK_DISABLED=false
OTEL_SERVICE_VERSION=dev
OTEL_DEPLOYMENT_ENVIRONMENT=local
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces
OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=http://localhost:9009/otlp/v1/metrics
OTEL_EXPORTER_OTLP_LOGS_ENDPOINT=http://localhost:3100/otlp/v1/logs
# Head-sampling probability for root spans (0..1); children inherit the parent.
# OTEL_TRACES_SAMPLER_ARG=1.0
# How often metrics are pushed to Mimir.
# OTEL_METRIC_EXPORT_INTERVAL=15s

# --- Service-to-service calls ------------------------------------------------
# Base URL for reaching enact-kb-api: the agent management API validates an
# agent's knowledge_base_ids against it, and the inference service fetches KB
# document contents from it when building model context. Defaults match the
# ports used in the README.
# KB_API_URL=http://localhost:8082
# KB_API_TIMEOUT=10s
# Base URL for reaching enact-agent-management-api: the inference service
# resolves agents through it (the source of truth for agent records).
# AGENT_API_URL=http://localhost:8084
# AGENT_API_TIMEOUT=10s

# --- Service-to-service authentication (S2S) ---------------------------------
# Every service signs a short-lived Ed25519 JWT per outbound call and
# verifies inbound tokens against a shared JWKS, then authorizes the caller
# against its own ACL (default deny). These variables carry the FULL YAML/PEM
# content, not file paths; scripts/start-services.sh fills them from the s2s/
# directory (generate keys first with `make s2s-keygen`), so they are listed
# here only for documentation / manual `go run` sessions.
# Master switch: with S2S_ENABLED=false the enforcement filter is not
# registered, outbound calls are unsigned, and no key material is required.
# S2S_ENABLED=true
# S2S_KEY_ID=<service name, e.g. enact-kb-api>
# S2S_JWKS=<contents of s2s/jwks.yaml>
# S2S_ACL=<contents of s2s/acl/<service>.yaml>
# S2S_PRIVATE_KEY=<contents of s2s/keys/<service>.key>
# S2S_TOKEN_TTL=60s
# enact-tests only: every service's private key (YAML, assembled by the
# start script from s2s/keys/) so test cases can impersonate any caller,
# plus the base URLs of the services under test.
# S2S_PRIVATE_KEYS=<yaml document, kid + private_key per service>
# INFERENCE_API_URL=http://localhost:8080
# MODELS_API_URL=http://localhost:8081
# TEST_USER_ID=integration-tests
# TEST_HTTP_TIMEOUT=15s

# --- Main service (UI backend) authentication --------------------------------
# Google OAuth client (Google Cloud console -> Credentials). The redirect URL
# must EXACTLY match a redirect URI registered on the client, and the service
# port must match the registered JavaScript origin.
# GOOGLE_CLIENT_ID=<...>.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=<...>
# OAUTH_REDIRECT_URL=http://localhost:8000/google/oauth/callback
# SESSION_TTL=24h
# Set behind TLS; leaves auth cookies HTTP-only-Lax but not Secure when off.
# SECURE_COOKIES=false
# Origin of the external frontend (separate repo). Enables CORS with
# credentials for exactly that origin and becomes the post-login redirect
# target. Leave unset to use the service's built-in pages.
# FRONTEND_URL=http://localhost:3000
# "lax" (default) or "none". "none" is required only when the frontend is on
# a different registrable domain; it forces Secure cookies => HTTPS, and the
# backend's Origin-check CSRF filter becomes the CSRF defense.
# COOKIE_SAMESITE=lax

# --- Administrator ----------------------------------------------------------
# The account with elevated rights in enact-main (/admin/create-user,
# /admin/delete-user, is_admin on /auth/me). Common to all services so they
# agree on the identity. Empty means no administrator.
# ADMIN_EMAIL=admin@example.com

# --- Per-service overrides --------------------------------------------------
# SERVICE_NAME shows up in each service's home page / Swagger title; set it
# per service when running, or leave unset to default to the binary name.
# Give each service a distinct port when running several on one host:
# SERVICE_PORT=8080
