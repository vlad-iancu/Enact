# enact-main-only environment (docker-compose.app.yml attaches this file to
# the enact-main container alone — FRONTEND_URL lives here precisely so CORS
# is not switched on for the other services). Copy to enact-main.env and
# fill in; enact-main.env is gitignored — never commit it.

# --- Google OAuth (Google Cloud console credentials) ------------------------
# OAUTH_REDIRECT_URL must exactly match a registered redirect URI and be
# reachable from the user's browser.
GOOGLE_CLIENT_ID=<client-id>.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=<client-secret>
OAUTH_REDIRECT_URL=https://<your-domain>/google/oauth/callback

# --- Browser-facing URLs ----------------------------------------------------
# PUBLIC_BASE_URL: this service as the browser reaches it (verification
# email links). FRONTEND_URL: the SPA origin (CORS + post-login redirects).
# Behind the Caddy web entry (see Caddyfile.example) the API lives under
# /api on the SAME origin as the SPA:
#   PUBLIC_BASE_URL=https://<domain>/api
#   OAUTH_REDIRECT_URL=https://<domain>/api/google/oauth/callback
#   FRONTEND_URL=https://<domain>
PUBLIC_BASE_URL=https://<your-domain>
FRONTEND_URL=https://<frontend-domain>

# --- Cookies ----------------------------------------------------------------
# Behind TLS set SECURE_COOKIES=true. COOKIE_SAMESITE=none is required ONLY
# when the frontend is on a different registrable domain — browsers then
# force Secure, so the deployment must be HTTPS (reverse proxy in front of
# port 8000; out of scope for the compose file).
SECURE_COOKIES=true
COOKIE_SAMESITE=lax
SESSION_TTL=24h

# --- Email verification (SES) -----------------------------------------------
# SES_FROM_EMAIL must be a verified SES identity; in SES sandbox mode the
# recipients must be verified too (or request production access). Set to
# false when SES cannot deliver yet (fresh stack, sandbox) — otherwise new
# local accounts can never log in.
EMAIL_VERIFICATION_ENABLED=true
SES_FROM_EMAIL=<verified-sender@example.com>
VERIFICATION_TTL=24h

# --- Avatar storage ---------------------------------------------------------
S3_BUCKET=enact-storage
CLOUDFRONT_BASE_URL=https://<distribution-id>.cloudfront.net
