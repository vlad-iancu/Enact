# Shared environment for every enact app container (docker-compose.app.yml).
# Copy to app.env next to the compose file and fill in the real values;
# app.env is gitignored — never commit it.

# --- Administrator ----------------------------------------------------------
# The account with elevated rights in enact-main (/admin endpoints, is_admin
# on /auth/me). Common to all services. Empty means no administrator.
ADMIN_EMAIL=<admin@example.com>

# --- Service-to-service auth ------------------------------------------------
# Key material paths are set in the compose file (S2S_*_FILE onto the /s2s
# mount); this only toggles enforcement.
S2S_ENABLED=true

# --- Infrastructure ---------------------------------------------------------
# OpenSearch, Redis, and Tika run INSIDE the compose stack; their connection
# settings live in docker-compose.app.yml (x-infra-env), not here — compose
# `environment:` entries override this file, so setting OPENSEARCH_*/REDIS_*
# here would have no effect. The cluster admin password comes from
# OPENSEARCH_PASSWORD in the compose project's .env file.

# --- AWS (Bedrock inference/embeddings, S3 avatars, SES email) --------------
# Containers have no ~/.aws, so AWS_PROFILE cannot be used here: static
# credentials only.
AWS_REGION=eu-north-1
AWS_ACCESS_KEY_ID=<access-key-id>
AWS_SECRET_ACCESS_KEY=<secret-access-key>
BEDROCK_API_KEY=<bedrock-api-key>

# --- RAG chunking (must match between enact-kb-api and the indexer) ---------
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=150

# --- Observability ----------------------------------------------------------
# Disabled until managed OTLP endpoints exist (the local LGTM stack is not
# part of this deployment). To enable, remove OTEL_SDK_DISABLED and set the
# three per-signal endpoints (there is no generic OTEL_EXPORTER_OTLP_ENDPOINT).
OTEL_SDK_DISABLED=true
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=https://<tempo>/v1/traces
# OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=https://<mimir>/otlp/v1/metrics
# OTEL_EXPORTER_OTLP_LOGS_ENDPOINT=https://<loki>/otlp/v1/logs
# OTEL_DEPLOYMENT_ENVIRONMENT=production

LOGGING_LEVEL=info
