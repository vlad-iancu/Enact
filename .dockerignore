# Keep the image build context free of secrets and host-only artifacts.
# dist/ holds built binaries, real env files and an OAuth client secret;
# s2s/ holds private keys; deploy/ and mappings/ are host-side only.
.git/
.idea/
.DS_Store
dist/
deploy/
# docs/adr and the rest are host-side, but docs/app is EMBEDDED into
# enact-main (see docs/embed.go) — excluding it makes the image build fail at
# the go:embed directive, not at runtime.
docs/
!docs/app/
!docs/embed.go
mappings/
s2s/
scripts/
.env
*.env
README.md
Dockerfile
.dockerignore
