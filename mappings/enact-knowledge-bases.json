{
  "index_patterns": [
    "enact-knowledge-bases"
  ],
  "priority": 100,
  "_meta": {
    "description": "Knowledge-base metadata records: id, owner, friendly name, and kind (context: documents stored whole; rag: documents chunked and embedded)."
  },
  "template": {
    "settings": {
      "number_of_shards": 1,
      "number_of_replicas": 0
    },
    "mappings": {
      "properties": {
        "id": {
          "type": "keyword"
        },
        "user_id": {
          "type": "keyword"
        },
        "organization_id": {
          "type": "keyword"
        },
        "created_at": {
          "type": "date"
        },
        "name": {
          "type": "text"
        },
        "kind": {
          "type": "keyword"
        },
        "chunk_size": {
          "type": "integer"
        },
        "chunk_overlap": {
          "type": "integer"
        },
        "updated_at": {
          "type": "date"
        }
      }
    }
  }
}
