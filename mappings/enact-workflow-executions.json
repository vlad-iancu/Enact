{
  "index_patterns": [
    "enact-workflow-executions"
  ],
  "priority": 100,
  "_meta": {
    "description": "One record per workflow run: the trigger input, the step definitions as they were at the time, and what each step did. Everything user-shaped is stored but not indexed."
  },
  "template": {
    "settings": {
      "number_of_shards": 1,
      "number_of_replicas": 0
    },
    "mappings": {
      "properties": {
        "id": {
          "type": "keyword"
        },
        "workflow_id": {
          "type": "keyword"
        },
        "user_id": {
          "type": "keyword"
        },
        "organization_id": {
          "type": "keyword"
        },
        "status": {
          "type": "keyword"
        },
        "error": {
          "type": "text",
          "index": false
        },
        "input": {
          "type": "object",
          "enabled": false
        },
        "output": {
          "type": "object",
          "enabled": false
        },
        "steps": {
          "type": "object",
          "enabled": false
        },
        "runs": {
          "type": "object",
          "enabled": false
        },
        "queued_at": {
          "type": "date"
        },
        "started_at": {
          "type": "date"
        },
        "finished_at": {
          "type": "date"
        }
      }
    }
  }
}
