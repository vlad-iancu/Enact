{
  "index_patterns": [
    "enact-conversations"
  ],
  "priority": 100,
  "_meta": {
    "description": "Chat conversations: per-user message threads. Deliberately not bound to an agent or model \u2014 each message records what it was answered by, and an assistant message records the MCP tool calls it made. tool_calls is stored but NOT indexed: a tool's arguments are arbitrary model JSON, and dynamic mapping would turn every argument name into an index field."
  },
  "template": {
    "settings": {
      "number_of_shards": 1,
      "number_of_replicas": 0
    },
    "mappings": {
      "properties": {
        "id": {
          "type": "keyword"
        },
        "user_id": {
          "type": "keyword"
        },
        "title": {
          "type": "text"
        },
        "message_count": {
          "type": "integer"
        },
        "messages": {
          "type": "object",
          "properties": {
            "role": {
              "type": "keyword"
            },
            "content": {
              "type": "text",
              "index": false
            },
            "agent_id": {
              "type": "keyword"
            },
            "model": {
              "type": "keyword"
            },
            "created_at": {
              "type": "date"
            },
            "attachments": {
              "type": "keyword"
            },
            "tool_calls": {
              "type": "object",
              "enabled": false
            }
          }
        },
        "created_at": {
          "type": "date"
        },
        "updated_at": {
          "type": "date"
        }
      }
    }
  }
}
